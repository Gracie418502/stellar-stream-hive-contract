{
  "name": "stellar-stream-hive-contract",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"],
      "settings": {
        "editor.formatOnSave": true,
        "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" }
      }
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "CARGO_TERM_COLOR": "always"
  },
  "postCreateCommand": "rustup show && rustup target add wasm32v1-none && cargo install just --locked && cargo install stellar-cli --locked && stellar --version"
}
