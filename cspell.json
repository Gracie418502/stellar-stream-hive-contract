{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "dictionaries": ["softwareTerms", "companies"],
  "ignoreRegExpList": [
    "\\b[GCSMT][A-Z2-7]{55}\\b",
    "\\b[0-9a-fA-F]{32,}\\b",
    "<!--[\\s\\S]*?-->"
  ],
  "words": [
    "clippy",
    "contractevent",
    "contracterror",
    "contractimpl",
    "contracttype",
    "handsoff",
    "ledgers",
    "Repoints",
    "repoint",
    "repoints",
    "rustup",
    "Sablier",
    "SEP",
    "soroban",
    "Soroban",
    "stroop",
    "stroops",
    "strkey",
    "testutils",
    "unclaimable",
    "unstreamed",
    "unwithdrawable",
    "custodied",
    "underflow",
    "underflowed",
    "underflows",
    "PRNG",
    "RUSTSEC",
    "behaviour",
    "nocapture",
    "println"
  ],
  "ignorePaths": ["target", "Cargo.lock", "test_snapshots", "node_modules"]
}
